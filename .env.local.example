# Gateway to talk to (dev by default — never point this at prod until proven)
GATEWAY_URL=https://gateway-dev-1077801427223.asia-south1.run.app

# Must match auth-service's JWT_SECRET exactly — this app verifies access
# tokens itself (in middleware) rather than trusting an unverified decode.
JWT_SECRET=

# Firebase Web app config for "Sign in with Google" (client-side, safe to
# expose — not secrets). Get these from the Firebase Console for the
# existing "phool-gobhi" project: Project Settings > General > Your apps >
# Add app > Web (if a web app isn't registered yet, adding one takes ~30s
# and needs no extra setup). Also enable Google under Authentication >
# Sign-in method if it isn't already.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
